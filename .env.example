# Veritas Legal AI - Environment Template
# Duplicate this file as .env and fill in your preferred provider:

# Option 1: Google Gemini (Free & High Speed)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup key (automatically switches if primary hits quota / rate limit):
GEMINI_API_KEY_BACKUP=optional_backup_gemini_key_for_failover
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite

# Option 2: Local Ollama (100% Offline, Zero Cost)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:1.5b

# Option 3: OpenAI
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option 4: Groq
# GROQ_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# Database Storage Support:
# 1. MongoDB Atlas (Recommended for Serverless / Vercel cloud persistence):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/veritas_legal_ai?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/veritas_legal_ai?retryWrites=true&w=majority

# 2. PostgreSQL (Alternative cloud or local DB):
# DATABASE_URL=postgresql://user:password@localhost:5432/veritas

# 3. Native Node SQLite (Default fallback when no remote DB is specified: data/contracts.db)
