# Veritas Legal AI - Environment Template
# Duplicate this file as .env and fill in your preferred provider:

# Option 1: Google Gemini (Free & High Speed)
GEMINI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite

# Option 2: Local Ollama (100% Offline, Zero Cost)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:1.5b

# Option 3: OpenAI
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option 4: Groq
# GROQ_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# Dual Database Support:
# By default, Veritas uses native Node SQLite (data/contracts.db).
# To use PostgreSQL, provide your connection string below:
# DATABASE_URL=postgresql://user:password@localhost:5432/veritas
